With --strict_source_directories, a rule selected by directory that has files
in a subdirectory is skipped with a warning.
-- args --
move --src_package=//libc --dst_package=//libc/src/stdlib --strict_source_directories
-- in/libc/BUILD.bazel --
cc_library(
    name = "abort",
    srcs = ["src/stdlib/linux/abort.cpp"],
    hdrs = ["src/stdlib/abort.h"],
)

cc_library(
    name = "atoi",
    srcs = ["src/stdlib/atoi.cpp"],
)
-- out/libc/BUILD.bazel --
cc_library(
    name = "abort",
    srcs = ["//libc/src/stdlib:linux/abort.cpp"],
    hdrs = ["//libc/src/stdlib:abort.h"],
)
-- out/libc/src/stdlib/BUILD.bazel --
cc_library(
    name = "atoi",
    srcs = ["atoi.cpp"],
)
-- stderr --
Moved 1 rules from //libc to //libc/src/stdlib (0 renamed, 0 aliased).
Rewrote references in 1 files:
  libc/BUILD.bazel: 2
Warnings (3):
  libc/BUILD.bazel:3: [leftover-reference] "src/stdlib/linux/abort.cpp" now belongs to //libc/src/stdlib; rewritten to "//libc/src/stdlib:linux/abort.cpp", which needs an exports_files there
  libc/BUILD.bazel:4: [leftover-reference] "src/stdlib/abort.h" now belongs to //libc/src/stdlib; rewritten to "//libc/src/stdlib:abort.h", which needs an exports_files there
  libc/BUILD.bazel:1: [nested-skipped] "abort" has files in subdirectories of src/stdlib/; skipped because of --strict_source_directories
