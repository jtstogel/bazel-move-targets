--include_name_prefix also selects rules without files whose names start
with the prefix. Rules with files elsewhere are not selected.
-- args --
move --src_package=//libc --dst_package=//libc/src/stdlib --include_name_prefix=stdlib_
-- in/libc/BUILD.bazel --
cc_library(
    name = "stdlib_all",
    deps = [":atoi"],
)

cc_library(
    name = "stdlib_elsewhere",
    srcs = ["src/other/x.cpp"],
)

cc_library(
    name = "string_all",
)

cc_library(
    name = "atoi",
    srcs = ["src/stdlib/atoi.cpp"],
)
-- out/libc/BUILD.bazel --
cc_library(
    name = "stdlib_elsewhere",
    srcs = ["src/other/x.cpp"],
)

cc_library(
    name = "string_all",
)
-- out/libc/src/stdlib/BUILD.bazel --
cc_library(
    name = "stdlib_all",
    deps = [":atoi"],
)

cc_library(
    name = "atoi",
    srcs = ["atoi.cpp"],
)
-- stderr --
Moved 2 rules from //libc to //libc/src/stdlib (0 renamed, 0 aliased).
Warnings (1):
  libc/BUILD.bazel:1: [no-file-attrs] "stdlib_all" has no file attributes; its macro may compute package-relative paths
