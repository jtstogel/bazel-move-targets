--verbose also lists rules without files, and hints at the ones whose names
match a strip prefix.
-- args --
plan --verbose --src_package=//libc --dst_package=//libc/src/__support/CPP --rename_strip_package_prefix=__support_cpp_ --out=$TMP/config.json
-- in/libc/BUILD.bazel --
cc_library(
    name = "__support_cpp_bit",
    hdrs = ["src/__support/CPP/bit.h"],
)

cc_library(
    name = "__support_cpp_all",
    deps = [":__support_cpp_bit"],
)

cc_library(
    name = "everything",
    deps = [":__support_cpp_all"],
)
-- stderr --
